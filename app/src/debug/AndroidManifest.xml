<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application>
        <!-- Lab-only fixed controller. Ordinary applications cannot invoke it. -->
        <receiver
            android:name=".debug.directshell.DirectRootLabReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Registers a lazy DirectShell factory; no shell process is launched at app startup. -->
        <provider
            android:name=".debug.directshell.DirectShellRuntimeAutoRegistrationProvider"
            android:authorities="${applicationId}.directshell.runtime"
            android:exported="false"
            android:initOrder="100" />
        <!-- Debug-only owned target used to inspect the Shizuku UserService framework API surface. -->
        <activity
            android:name=".debug.input.InputApiForensicsActivity"
            android:exported="true"
            android:noHistory="true" />
        <activity
            android:name=".debug.input.InputProductionValidationActivity"
            android:exported="true"
            android:noHistory="true" />
        <activity
            android:name=".debug.audio.SystemAudioProductionValidationActivity"
            android:exported="true"
            android:noHistory="true" />
        <!-- DEBUG-only normal Android playback source for SystemAudio E2E validation. -->
        <activity
            android:name=".debug.audio.SystemAudioE2eToneActivity"
            android:exported="true"
            android:noHistory="true" />
        <activity
            android:name=".debug.privilege.UserServiceBootstrapProbeActivity"
            android:exported="true"
            android:noHistory="true" />
        <!-- DEBUG-only normal-app client for the isolated app_process DirectShell probe. -->
        <activity
            android:name=".debug.directshell.DirectShellProbeActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:noHistory="true" />
        <!-- DEBUG-only user-consented Wireless Debugging / self-ADB bootstrap feasibility UI. -->
        <activity
            android:name=".debug.directshell.DirectShellSelfBootstrapProbeActivity"
            android:exported="true"
            android:launchMode="singleTop" />
        <service
            android:name=".debug.directshell.DirectShellSelfBootstrapPairingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- DEBUG-only normal-app controller for the isolated shell REMOTE_SUBMIX probe. -->
        <activity
            android:name=".debug.directshell.DirectShellSystemAudioProbeActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:noHistory="true" />
        <!-- DEBUG-only controller and shell-gated Binder endpoint for FD handoff feasibility. -->
        <activity
            android:name=".debug.directshell.DirectShellFdProbeActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- DEBUG-only, one-operation external-provider path for shell FD handoff feasibility. -->
        <provider
            android:name=".debug.directshell.DirectShellFdProbeContentProvider"
            android:authorities="io.warpnect.debug.directshell.fdprobe"
            android:exported="true" />
        <!-- DEBUG-only, shell-gated descriptor set for the DirectShell PCM-ring integration spike. -->
        <provider
            android:name=".debug.directshell.DirectShellPcmRingProbeContentProvider"
            android:authorities="io.warpnect.debug.directshell.pcmringprobe"
            android:exported="true" />
        <!-- DEBUG-only shell-gated Surface handoff for the DirectShell display-capture probe. -->
        <provider
            android:name=".debug.directshell.DirectShellVideoCaptureProbeContentProvider"
            android:authorities="io.warpnect.debug.directshell.videocaptureprobe"
            android:exported="true" />
        <!-- DEBUG-only non-UI command surface so sampling does not interrupt the tone activity. -->
        <receiver
            android:name=".debug.directshell.DirectShellSystemAudioProbeReceiver"
            android:exported="true" />
        <!-- DEBUG-only normal-process control surface for the DirectShell PCM-ring spike. -->
        <receiver
            android:name=".debug.directshell.DirectShellPcmRingProbeReceiver"
            android:exported="true" />
        <!-- DEBUG-only Session source switch for the DirectShell remote SystemAudio E2E spike. -->
        <receiver
            android:name=".debug.directshell.DirectShellSystemAudioRemoteE2eReceiver"
            android:exported="true" />
        <!-- DEBUG-only normal-process controller for bounded DirectShell Input injection. -->
        <receiver
            android:name=".debug.directshell.DirectShellInputProbeReceiver"
            android:exported="true" />
        <!-- DEBUG-only Host Session source switch for the DirectShell privileged Input spike. -->
        <receiver
            android:name=".debug.directshell.DirectShellInputSessionIntegrationReceiver"
            android:exported="true" />
        <!-- DEBUG-only one-shot selector test; it cannot create a capability or alter release builds. -->
        <receiver
            android:name=".debug.directshell.DirectShellOptionalProviderTestReceiver"
            android:exported="true" />
        <!-- DEBUG-only normal-process control surface for the DirectShell display-capture probe. -->
        <receiver
            android:name=".debug.directshell.DirectShellVideoCaptureProbeReceiver"
            android:exported="true" />
        <!-- DEBUG-only Host Session source switch for the DirectShell display-capture spike. -->
        <receiver
            android:name=".debug.directshell.DirectShellVideoSessionIntegrationReceiver"
            android:exported="true" />
        <!-- DEBUG-only visual fixture; it deliberately has no audio behavior. -->
        <activity
            android:name=".debug.directshell.DirectShellVideoCaptureProbeActivity"
            android:exported="true"
            android:launchMode="singleTop" />
        <!-- Debug-only, non-privileged target for end-to-end reverse-input validation. -->
        <activity
            android:name=".debug.input.InputSessionTargetActivity"
            android:exported="true" />
        <!-- Debug-only presentation sanity check for the immutable RFC-002I AVC fixture. -->
        <activity
            android:name=".debug.video.ClientFixturePresentationActivity"
            android:exported="true" />
        <!-- Debug-only exact-key cache invalidation for cold qualification timing. -->
        <activity
            android:name=".debug.capability.CapabilityQualificationDebugActivity"
            android:exported="true"
            android:noHistory="true" />
    </application>

</manifest>
